{
  "name": "fufu-proposals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css-types": "node -e \"require('node:fs').rmSync('.generated/css-types', { recursive: true, force: true })\" && tcm src --pattern \"**/*.module.css\" --allowArbitraryExtensions --outDir .generated/css-types && prettier --write \".generated/css-types/**/*.module.d.css.ts\"",
    "check:generated-clean": "node scripts/check-generated-clean.mjs",
    "components:validate": "node scripts/validate-component-structure.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps chromium",
    "proposals:clean": "node scripts/check-proposals-clean.mjs",
    "privacy:check-build": "node scripts/check-private-bundles.mjs",
    "launch:check": "node scripts/check-launch-ready.mjs",
    "verify:quick": "npm run components:validate && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run format:check && npm run css-types && npm run components:validate && npm run lint && npm run typecheck && npm run test && npm run build && npm run privacy:check-build",
    "verify:proposal": "npm run verify && npm run check:generated-clean && npm run proposals:clean",
    "verify:handoff": "npm run verify:proposal && npm run launch:check && npm run test:e2e",
    "verify:release": "npm run verify:handoff && npm run lhci",
    "lhci": "lhci autorun",
    "analyze": "next experimental-analyze --output"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
